<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= user.display_name %> - Minecraft Social</title>
  <link rel="stylesheet" href="/public/css/bedrock.css" />
</head>
<body class="bg">
  <%- include('partials/nav') %>
  <div class="container">
    <div class="profile-header card">
      <img class="avatar xl" src="<%= user.avatar_path || '/public/css/steve.png' %>" />
      <div>
        <h2><%= user.display_name %></h2>
        <div class="muted">@<%= user.username %></div>
        <p><%= user.bio %></p>
        <form method="POST" action="/u/<%= user.username %>/<%= isFollowing ? 'unfollow' : 'follow' %>">
          <button class="btn" type="submit"><%= isFollowing ? 'Unfollow' : 'Follow' %></button>
        </form>
      </div>
    </div>

    <% posts.forEach(p => { %>
      <div class="card post">
        <div class="content"><%= p.content %></div>
        <% if (p.image_path) { %>
          <img class="post-img" src="<%= p.image_path %>" alt="post image" />
        <% } %>
      </div>
    <% }) %>
  </div>
</body>
</html>
